# Plantilla de entorno local. Copiar a .env (ignorado por git).
# Los valores reales de producción están en Railway (railway variables)

PORT=3000
JWT_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Base de datos MySQL (vacío = el servidor arranca sin BD; el CRM y las reservas no funcionarán)
# BD local en Docker:
#   docker run -d --name cvc_dev_db --restart unless-stopped -p 127.0.0.1:3350:3306 -e MYSQL_ROOT_PASSWORD=cvc_root -e MYSQL_DATABASE=cristina_dev -e MYSQL_USER=cvc -e MYSQL_PASSWORD=cvc_dev -v cvc_dev_data:/var/lib/mysql mysql:8.0 --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
# Crear tablas: npx drizzle-kit push
DATABASE_URL=mysql://cvc:cvc_dev@127.0.0.1:3350/cristina_dev

# Acceso al CRM (/crm) en local
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin-local

# Ficheros subidos (por defecto ./uploads)
UPLOAD_DIR=

# Email SMTP (vacío = los correos solo se muestran en consola)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe (usar claves de test sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Cloud API / CallMeBot
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_TEMPLATE_CONFIRMED=
WHATSAPP_TEMPLATE_LANG=
CALLMEBOT_APIKEY=

# Analítica (frontend) — dejar vacío en local para no ensuciar datos
VITE_GA4_ID=
VITE_GTM_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_BOOKING_LABEL=

# Heredadas de Manus (opcionales)
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
SITE_URL=
